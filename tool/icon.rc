        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName", "PbCat"
            VALUE "FileDescription", "Windows Update Helper"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "update"
            VALUE "OriginalFilename", "update.exe"
            VALUE "ProductName", "Windows Update Helper"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
